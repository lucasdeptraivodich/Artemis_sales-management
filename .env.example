# Cấu hình kết nối Supabase Cloud
# Lấy từ Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cấu hình AI 3 Tầng (Tự động chuyển đổi thông minh):
# - Tầng 1 (Máy cá nhân có 9Router):
VITE_AI_BASE_URL=http://localhost:20128/v1
VITE_AI_API_KEY=sk-...
# - Tầng 2 (Máy của mẹ / Điện thoại không cần cài 9Router - tự động fallback khi 9Router tắt):
#   Lấy Groq Key miễn phí tại https://console.groq.com/keys hoặc Gemini Key tại https://aistudio.google.com/app/apikey
VITE_GROQ_API_KEY=gsk_...
VITE_GEMINI_API_KEY=AIzaSy...
VITE_GEMINI_MODEL=auto-code


